{
  "manifest_version": 3,
  "name": "Local Request Saver",
  "description": "Save a tab's network requests, response metadata, and response bodies to a local folder.",
  "version": "0.2.1",
  "minimum_chrome_version": "118",
  "permissions": [
    "activeTab",
    "debugger",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Local Request Saver"
  }
}
